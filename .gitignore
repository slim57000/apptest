# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Symboles de débogage générés par `flutter build ... --obfuscate
# --split-debug-info=debug-info` : nécessaires pour décoder les stack
# traces de crash plus tard, à archiver en lieu sûr (PAS dans ce dépôt
# public — ils permettraient de désobfusquer le code).
/debug-info/

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signature de release (clé d'upload Play Store) : jamais dans le dépôt.
# Voir android/key.properties.example et le README ("Signer l'app pour
# publication").
/android/key.properties
*.jks
*.keystore

# Widget Preview related
.widget_preview/

# Generated localization code (regenerated automatically via `generate: true`
# in pubspec.yaml / `flutter gen-l10n`; source of truth is lib/l10n/*.arb)
/lib/l10n/app_localizations*.dart
